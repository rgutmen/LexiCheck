# Copy to .env.local (gitignored) and fill in. The Makefile loads it automatically.
# Never commit the real file.

# --- AWS: credentials for make aws-* (or use AWS_PROFILE instead of keys)
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION=eu-west-1
# export AWS_PROFILE=my-profile

# --- OpenAI: optional, enables "Rewrite with AI"
# Locally it's passed to the API container. For AWS, `make aws-openai-key`
# copies it into Secrets Manager; it's never stored anywhere else.
export OPENAI_API_KEY=
export OPENAI_MODEL=gpt-4o-mini
